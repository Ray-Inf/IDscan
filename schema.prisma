generator client {
  provider = "prisma-client-py"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Core User Models

model Admin {
  id        String   @id
  username  String   @unique
  name      String
  email     String?  @unique
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
}

model Student {
  id        String   @id
  username  String   @unique
  cardId    String   @unique // ID card identifier
  name      String
  surname   String
  email     String?  @unique
  phone     String?  @unique
  address   String
  img       String? // Profile image
  imagePath String? // Face recognition image
  bloodType String?
  sex       UserSex
  birthday  DateTime
  createdAt DateTime @default(now())

  // Academic relationships
  parentId String
  parent   Parent @relation(fields: [parentId], references: [id], onDelete: Cascade)
  classId  Int
  class_   Class_ @relation(fields: [classId], references: [id], onDelete: Cascade)
  gradeId  Int
  grade    Grade  @relation(fields: [gradeId], references: [id], onDelete: Cascade)

  // Academic data
  admissionYear String?
  yearOfStudy   String?
  division      String?
  department    String?

  // Relationships
  attendances     Attendance[]
  classAttendance ClassAttendance[]
  results         Result[]

  // Facility usage logs
  gymLogs      GymLog[]
  libraryLogs  LibraryLog[]
  facilityLogs FacilityAttendanceLog[]
}

model Teacher {
  id         String   @id
  username   String   @unique
  cardId     String   @unique // ID card identifier
  name       String
  surname    String
  email      String?  @unique
  phone      String?  @unique
  address    String
  img        String? // Profile image
  imagePath  String? // Face recognition image
  bloodType  String?
  sex        UserSex
  birthday   DateTime
  department String?
  createdAt  DateTime @default(now())

  // Academic relationships
  subjects Subject[]
  lessons  Lesson[]
  classes  Class_[]

  // Classes taught
  teacherClasses Class_[] @relation("TeacherClasses")
}

model Parent {
  id        String    @id
  username  String    @unique
  name      String
  surname   String
  email     String?   @unique
  phone     String    @unique
  address   String
  createdAt DateTime  @default(now())
  students  Student[]
}

// Academic Structure Models

model Grade {
  id       Int       @id @default(autoincrement())
  level    Int       @unique
  students Student[]
  classes  Class_[]
}

model Class_ {
  id            Int               @id @default(autoincrement())
  name          String            @unique
  capacity      Int
  supervisorId  String?
  supervisor    Teacher?          @relation(fields: [supervisorId], references: [id], onDelete: Cascade)
  lessons       Lesson[]
  students      Student[]
  gradeId       Int
  grade         Grade             @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  events        Event[]
  announcements Announcement[]
  teachers      Teacher[]         @relation("TeacherClasses")
  classRecords  ClassAttendance[]
}

model Subject {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  teachers Teacher[]
  lessons  Lesson[]
}

model Lesson {
  id        Int      @id @default(autoincrement())
  name      String
  day       Day
  startTime DateTime
  endTime   DateTime

  subjectId   Int
  subject     Subject      @relation(fields: [subjectId], references: [id])
  classId     Int
  class_      Class_       @relation(fields: [classId], references: [id], map: "class")
  teacherId   String
  teacher     Teacher      @relation(fields: [teacherId], references: [id])
  exams       Exam[]
  assignments Assignment[]
  attendances Attendance[]
}

// ID Template System (from database_setup.py)

model IDTemplate {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
}

model Template {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  organization  String
  templateClass String
  createdAt     DateTime @default(now())
}

// Attendance Tracking Models

model Attendance {
  id      Int      @id @default(autoincrement())
  date    DateTime
  present Boolean

  studentId String
  student   Student @relation(fields: [studentId], references: [id])
  lessonId  Int
  lesson    Lesson  @relation(fields: [lessonId], references: [id])
}

model ClassAttendance {
  id          Int      @id @default(autoincrement())
  classId     Int
  cardId      String
  date        DateTime @db.Date
  checkInTime DateTime
  status      String   @default("present")
  createdAt   DateTime @default(now())
  class_      Class_   @relation(fields: [classId], references: [id])
  // Relationships
  student     Student  @relation(fields: [cardId], references: [cardId])

  @@unique([classId, cardId, date], name: "unique_attendance")
}

// Facility Access Models

model FacilityAttendanceLog {
  id         Int       @id @default(autoincrement())
  cardId     String
  facilityId String
  loginTime  DateTime
  logoutTime DateTime?

  // Relationships
  student Student @relation(fields: [cardId], references: [cardId])
}

model LibraryLog {
  id         Int       @id @default(autoincrement())
  cardId     String
  bookId     Int?
  loginTime  DateTime
  logoutTime DateTime?
  timeSpent  Int?
  createdAt  DateTime  @default(now())

  // Relationships
  student Student @relation(fields: [cardId], references: [cardId])
  book    Book?   @relation(fields: [bookId], references: [id])
}

model Book {
  id        Int      @id @default(autoincrement())
  title     String
  author    String
  isbn      String   @unique
  status    String   @default("available")
  createdAt DateTime @default(now())

  // Relationships
  libraryLogs LibraryLog[]
}

model GymLog {
  id           Int       @id @default(autoincrement())
  cardId       String
  loginTime    DateTime
  logoutTime   DateTime?
  activityType String?
  createdAt    DateTime  @default(now())

  // Relationships
  student Student @relation(fields: [cardId], references: [cardId])
}

// Academic Performance Models

model Exam {
  id        Int      @id @default(autoincrement())
  title     String
  startTime DateTime
  endTime   DateTime
  lessonId  Int
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  results   Result[]
}

model Assignment {
  id        Int      @id @default(autoincrement())
  title     String
  startDate DateTime
  dueDate   DateTime

  lessonId Int
  lesson   Lesson   @relation(fields: [lessonId], references: [id])
  results  Result[]
}

model Result {
  id    Int @id @default(autoincrement())
  score Int

  examId       Int?
  exam         Exam?       @relation(fields: [examId], references: [id])
  assignmentId Int?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id])
  studentId    String
  student      Student     @relation(fields: [studentId], references: [id])
}

// School Events and Announcements

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  startTime   DateTime
  endTime     DateTime

  classId Int?
  class_  Class_? @relation(fields: [classId], references: [id])
}

model Announcement {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  date        DateTime

  classId Int?
  class_  Class_? @relation(fields: [classId], references: [id])
}

// Enumerations

enum UserSex {
  MALE
  FEMALE
}

enum Day {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}

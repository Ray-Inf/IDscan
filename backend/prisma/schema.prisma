generator client {
  provider = "prisma-client-py"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Core User Models

model Admin {
  
  username  String   @unique
  cardId    String  @unique
  name      String
  email     String?  @unique
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  templateId String
  libraryLogs LibraryLog[] // Relation to LibraryLog
  gymLogs     GymLog[]     // Relation to GymLog
  hostelLogs  HostelLog[]  // Relation to HostelLog
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  img        String?
  imagePath  String?
  attendanceLogs AttendanceLog[]
  facilityLogs   FacilityAttendanceLog[]
}

model Student {
  cardId    String   @id @unique // Use cardId as the primary key
  username  String   @unique
  name      String
  surname   String
  email     String?  @unique
  phone     String?  @unique
  address   String
  img       String?
  imagePath String?
  bloodType String?
  sex       UserSex
  birthday  DateTime
  createdAt DateTime @default(now())

  // Academic relationships
  parentId String
  parent   Parent @relation(fields: [parentId], references: [id], onDelete: Cascade)
  classId  Int
  class_   Class_ @relation(fields: [classId], references: [id], onDelete: Cascade)
  gradeId  Int
  grade    Grade  @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  templateId String

  // Academic data
  admissionYear String?
  yearOfStudy   String?
  division      String?
  department    String?

  // Relationships
  attendances     Attendance[]
  classAttendance ClassAttendance[]
  results         Result[]
  attendanceLogs AttendanceLog[]

  
  // Facility usage logs
  gymLogs      GymLog[]
  libraryLogs  LibraryLog[]
  hostelLogs   HostelLog[]
  facilityLogs FacilityAttendanceLog[]
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model Teacher {
  cardId     String   @id @unique // Use cardId as the primary key
  username   String   @unique
  name       String
  surname    String
  email      String?  @unique
  phone      String?  @unique
  address    String
  img        String?
  imagePath  String?
  bloodType  String?
  sex        UserSex
  birthday   DateTime
  department String?
  createdAt  DateTime @default(now())
  
  // Academic relationships
  subjects Subject[]
  lessons  Lesson[]
  classes  Class_[]

  // Classes taught
  libraryLogs  LibraryLog[]
  gymLogs      GymLog[]
  teacherClasses Class_[] @relation("TeacherClasses")
  templateId String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  attendanceLogs AttendanceLog[]
  facilityLogs   FacilityAttendanceLog[]
}

model Parent {
  id        String    @id
  username  String    @unique
  name      String
  surname   String
  email     String?   @unique
  phone     String    @unique
  address   String
  createdAt DateTime  @default(now())
  students  Student[]
}

// Academic Structure Models

model Grade {
  id         Int       @id @default(autoincrement()) // Auto-generate the ID
  level    Int       @unique
  students Student[]
  classes  Class_[]
}

model Class_ {
  id         Int       @id @default(autoincrement()) // Auto-generate the ID
  name          String            @unique
  capacity      Int
  supervisorId  String?
  supervisor    Teacher?          @relation(fields: [supervisorId], references: [cardId], onDelete: Cascade) // Updated to reference cardId
  lessons       Lesson[]
  students      Student[]
  gradeId       Int
  grade         Grade             @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  events        Event[]
  announcements Announcement[]
  teachers      Teacher[]         @relation("TeacherClasses")
  classRecords  ClassAttendance[]
}

model Subject {
  id         Int       @id @default(autoincrement()) // Auto-generate the ID
  name     String    @unique
  teachers Teacher[]
  lessons  Lesson[]
}

model Lesson {
  id         Int       @id @default(autoincrement()) // Auto-generate the ID
  name      String
  day       Day
  startTime DateTime
  endTime   DateTime

  subjectId   Int
  subject     Subject      @relation(fields: [subjectId], references: [id])
  classId     Int
  class_      Class_       @relation(fields: [classId], references: [id], map: "class")
  teacherId   String
  teacher     Teacher      @relation(fields: [teacherId], references: [cardId]) // Updated to reference cardId
  exams       Exam[]
  assignments Assignment[]
  attendances Attendance[]
}

// ID Template System (from database_setup.py)

model IDTemplate {
  id        String    @id
  name      String
  createdAt DateTime @default(now())
}

model Template {
  id            String    @id
  name          String   @unique
  organization  String
  templateClass String
  createdAt     DateTime @default(now())
  image_path    String?
  features_path String?

  // Add relations to other models
  admins       Admin[]
  students     Student[]
  teachers     Teacher[]
  librarians   Librarian[]
  gymMasters   GymMaster[]
  hostelWardens HostelWarden[]
}

// Attendance Tracking Models

model Attendance {
  id         Int       @id @default(autoincrement()) // Auto-generate the ID
  date    DateTime
  present Boolean

  studentId String
  student   Student @relation(fields: [studentId], references: [cardId]) // Updated to reference cardId
  lessonId  Int
  lesson    Lesson  @relation(fields: [lessonId], references: [id])
}

model ClassAttendance {
  id         Int       @id @default(autoincrement()) // Auto-generate the ID
  classId     Int
  cardId      String
  date        DateTime 
  checkInTime DateTime
  checkOutTime DateTime?
  status      String   @default("present")
  createdAt   DateTime @default(now())
  class_      Class_   @relation(fields: [classId], references: [id])
  // Relationships
  student     Student  @relation(fields: [cardId], references: [cardId])
}

// Facility Access Models



model LibraryLog {
  id         Int      @id @default(autoincrement())
  studentId  String?   @map("student_cardId")
  teacherId  String?   @map("teacher_cardId")
  librarianId String?  @map("librarian_cardId")
  adminId    String?   @map("admin_cardId")  // Add this field
  bookId     String?
  loginTime  DateTime
  logoutTime DateTime?
  timeSpent  Int?
  createdAt  DateTime @default(now())

  // Relations
  admin     Admin?    @relation(fields: [adminId], references: [cardId])  // Updated to use adminId
  student    Student?   @relation(fields: [studentId], references: [cardId])
  teacher    Teacher?   @relation(fields: [teacherId], references: [cardId])
  librarian  Librarian? @relation(fields: [librarianId], references: [cardId])
  book       Book?      @relation(fields: [bookId], references: [id])
}

model Book {
  id        String    @id
  title     String
  author    String
  isbn      String   @unique
  status    String   @default("available")
  bookId     String?   // Add this field
  createdAt DateTime @default(now())

  // Relationships
  libraryLogs LibraryLog[]
}

model GymLog {
  id         Int       @id @default(autoincrement())
  studentId   String?    @map("student_cardId")
  teacherId   String?    @map("teacher_cardId")
  gymMasterId String?    @map("gymMaster_cardId")
  adminId     String?    @map("admin_cardId")  // Add this field
  
  loginTime    DateTime
  logoutTime   DateTime?
  activityType String?
  createdAt    DateTime  @default(now())

  // Relationships
  student   Student?   @relation(fields: [studentId], references: [cardId])
  teacher   Teacher?   @relation(fields: [teacherId], references: [cardId])
  gymMaster GymMaster? @relation(fields: [gymMasterId], references: [cardId])
  admin     Admin?     @relation(fields: [adminId], references: [cardId])  // Updated to use adminId
}

model HostelLog {
  id         Int       @id @default(autoincrement())
  studentId       String?    @map("student_cardId")
  hostelWardenId  String?    @map("hostelWarden_cardId")
  adminId         String?    @map("admin_cardId")  // Add this field

  loginTime  DateTime
  logoutTime DateTime?
  createdAt  DateTime  @default(now())

  // Relationships
  student       Student?      @relation(fields: [studentId], references: [cardId])
  hostelWarden HostelWarden? @relation(fields: [hostelWardenId], references: [cardId])
  admin        Admin?        @relation(fields: [adminId], references: [cardId])  // Updated to use adminId
}

// Academic Performance Models

model Exam {
  id         Int       @id @default(autoincrement()) // Auto-generate the ID
  title     String
  startTime DateTime
  endTime   DateTime
  lessonId  Int
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  results   Result[]
}

model Assignment {
  id         Int       @id @default(autoincrement()) // Auto-generate the ID
  title     String
  startDate DateTime
  dueDate   DateTime

  lessonId Int
  lesson   Lesson   @relation(fields: [lessonId], references: [id])
  results  Result[]
}

model Result {
  id         Int       @id @default(autoincrement()) // Auto-generate the ID
  score Int

  examId       Int?
  exam         Exam?       @relation(fields: [examId], references: [id])
  assignmentId Int?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id])
  studentId    String
  student      Student     @relation(fields: [studentId], references: [cardId]) // Updated to reference cardId
}

// School Events and Announcements

model Event {
  id         Int       @id @default(autoincrement()) // Auto-generate the ID
  title       String
  description String
  startTime   DateTime
  endTime     DateTime

  classId Int?
  class_  Class_? @relation(fields: [classId], references: [id])
}

model Announcement {
  id         Int       @id @default(autoincrement()) // Auto-generate the ID
  title       String
  description String
  date        DateTime

  classId Int?
  class_  Class_? @relation(fields: [classId], references: [id])
}

model Librarian {
  cardId        String    @id @unique // Use cardId as the primary key
  staffId       String    @unique
  name          String
  email         String?   @unique
  phone         String?   @unique
  address       String
  librarySection String
  bloodType     String?
  birthday      DateTime
  idCardImage   String?
  faceImage     String?
  createdAt     DateTime  @default(now())

  // Relationships
  libraryLogs   LibraryLog[]
  templateId   String
  attendanceLogs AttendanceLog[]
  facilityLogs   FacilityAttendanceLog[]
  template     Template   @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model GymMaster {
  cardId        String    @id @unique // Use cardId as the primary key
  staffId       String    @unique
  name          String
  email         String?   @unique
  phone         String?   @unique
  address       String
  specialization String
  bloodType     String?
  birthday      DateTime
  idCardImage   String?
  faceImage     String?
  createdAt     DateTime  @default(now())

  // Relationships
  gymLogs       GymLog[]
  templateId   String
  template     Template   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  attendanceLogs AttendanceLog[]
  facilityLogs   FacilityAttendanceLog[]
}

model HostelWarden {
  cardId        String    @id @unique // Use cardId as the primary key
  staffId       String    @unique
  name          String
  email         String?   @unique
  phone         String?   @unique
  address       String
  hostelName    String
  bloodType     String?
  birthday      DateTime
  idCardImage   String?
  faceImage     String?
  createdAt     DateTime  @default(now())

  // Relationships
  hostelLogs    HostelLog[]
  templateId   String
  attendanceLogs AttendanceLog[]
  facilityLogs   FacilityAttendanceLog[]
  template     Template   @relation(fields: [templateId], references: [id], onDelete: Cascade)
}
model AttendanceLog {
  id         String      @id @default(cuid())
  cardId     String      // Reference to the cardId of the role-specific model
  loginTime  DateTime
  logoutTime DateTime?
  status     String      @default("PRESENT") // PRESENT, ABSENT, LATE, etc.
  createdAt  DateTime    @default(now())

  // Relationships to all role models
  student      Student?      @relation(fields: [cardId], references: [cardId], map: "attendance_log_student_fkey")
  teacher      Teacher?      @relation(fields: [cardId], references: [cardId], map: "attendance_log_teacher_fkey")
  admin        Admin?        @relation(fields: [cardId], references: [cardId], map: "attendance_log_admin_fkey")
  librarian    Librarian?    @relation(fields: [cardId], references: [cardId], map: "attendance_log_librarian_fkey")
  gymMaster    GymMaster?    @relation(fields: [cardId], references: [cardId], map: "attendance_log_gym_master_fkey")
  hostelWarden HostelWarden? @relation(fields: [cardId], references: [cardId], map: "attendance_log_hostel_warden_fkey")
}
model FacilityAttendanceLog {
  id         String      @id @default(cuid())
  cardId     String      // Reference to the cardId of the role-specific model
  facilityId String
  loginTime  DateTime
  logoutTime DateTime?
  status     String      @default("PRESENT")
  createdAt  DateTime    @default(now())

  // Relationships to all role models
  student      Student?      @relation(fields: [cardId], references: [cardId], map: "facility_attendance_log_student_fkey")
  teacher      Teacher?      @relation(fields: [cardId], references: [cardId], map: "facility_attendance_log_teacher_fkey")
  admin        Admin?        @relation(fields: [cardId], references: [cardId], map: "facility_attendance_log_admin_fkey")
  librarian    Librarian?    @relation(fields: [cardId], references: [cardId], map: "facility_attendance_log_librarian_fkey")
  gymMaster    GymMaster?    @relation(fields: [cardId], references: [cardId], map: "facility_attendance_log_gym_master_fkey")
  hostelWarden HostelWarden? @relation(fields: [cardId], references: [cardId], map: "facility_attendance_log_hostel_warden_fkey")
}

// Enumerations

enum UserSex {
  MALE
  FEMALE
}

enum Day {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}